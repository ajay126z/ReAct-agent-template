"""LLM adapters behind one small protocol.

The ReAct loop only needs ``chat()``. Provider-specific request shapes, token
accounting, and error messages live here so the loop stays readable.
"""

from __future__ import annotations

import time
from collections.abc import Iterable
from dataclasses import dataclass
from typing import Any, Protocol, runtime_checkable

import httpx
{% if llm_provider in ["ollama", "both"] -%}
from ollama import AsyncClient, ResponseError
{% endif %}

from ..config import Settings
from ..observability.logging import get_logger
from ..observability.tracer import Tracer

log = get_logger("llm")


class LLMError(RuntimeError):
    """A model call failed in a way the user can fix."""


@dataclass(slots=True)
class LLMResponse:
    content: str
    prompt_tokens: int = 0
    completion_tokens: int = 0
    duration_ms: float = 0.0
    done_reason: str | None = None
    thinking: str | None = None


@runtime_checkable
class LLM(Protocol):
    """What the agent needs from a model provider."""

    async def chat(
        self,
        messages: list[dict[str, str]],
        *,
        stop: list[str] | None = None,
        temperature: float | None = None,
    ) -> LLMResponse: ...

    async def aclose(self) -> None: ...


class FakeLLM:
    """Scripted responses for tests and offline experimentation."""

    def __init__(self, responses: Iterable[str] = ()) -> None:
        self.responses = list(responses)
        self.calls: list[list[dict[str, str]]] = []

    async def chat(
        self,
        messages: list[dict[str, str]],
        *,
        stop: list[str] | None = None,
        temperature: float | None = None,
    ) -> LLMResponse:
        self.calls.append([dict(message) for message in messages])
        if not self.responses:
            raise LLMError("FakeLLM ran out of scripted responses.")
        content = self.responses.pop(0)
        prompt_chars = sum(len(message.get("content", "")) for message in messages)
        return LLMResponse(
            content=content,
            prompt_tokens=prompt_chars // 4,
            completion_tokens=len(content) // 4,
        )

    async def aclose(self) -> None:
        return None
{% if llm_provider in ["ollama", "both"] %}
{{ "\n\n" }}class OllamaLLM:
    """Async Ollama client for one configured model."""

    def __init__(self, settings: Settings, *, tracer: Tracer | None = None) -> None:
        self.settings = settings
        self.tracer = tracer
        self.client = AsyncClient(host=settings.ollama_host, timeout=settings.request_timeout)

    async def list_models(self) -> list[str]:
        try:
            response = await self.client.list()
        except Exception as exc:  # pragma: no cover - environmental
            raise LLMError(self._explain(exc)) from exc
        models = getattr(response, "models", None) or []
        names: list[str] = []
        for model in models:
            name = getattr(model, "model", None) or getattr(model, "name", None)
            if name:
                names.append(str(name))
        return names

    async def chat(
        self,
        messages: list[dict[str, str]],
        *,
        stop: list[str] | None = None,
        temperature: float | None = None,
    ) -> LLMResponse:
        options: dict[str, Any] = {
            "temperature": self.settings.temperature if temperature is None else temperature,
            "num_ctx": self.settings.num_ctx,
        }
        if stop:
            options["stop"] = stop

        started = time.perf_counter()
        try:
            response = await self.client.chat(
                model=self.settings.model,
                messages=messages,
                stream=False,
                think=self.settings.think,
                options=options,
                keep_alive=self.settings.keep_alive,
            )
        except Exception as exc:
            raise LLMError(self._explain(exc)) from exc
        duration_ms = (time.perf_counter() - started) * 1000
        result = self._to_response(response, duration_ms)

        if self.tracer is not None:
            with self.tracer.span(
                "llm.chat",
                kind="client",
                provider="ollama",
                model=self.settings.model,
                message_count=len(messages),
                prompt_tokens=result.prompt_tokens,
                completion_tokens=result.completion_tokens,
                duration_ms=round(result.duration_ms, 3),
            ):
                pass
        log.debug(
            "llm response model=%s prompt_tokens=%s completion_tokens=%s duration_ms=%.0f",
            self.settings.model,
            result.prompt_tokens,
            result.completion_tokens,
            result.duration_ms,
        )
        return result

    async def aclose(self) -> None:
        return None

    @staticmethod
    def _to_response(response: Any, duration_ms: float) -> LLMResponse:
        message = getattr(response, "message", None)
        content = (getattr(message, "content", None) or "").strip()
        thinking = getattr(message, "thinking", None)
        if not content and thinking:
            log.warning("model returned empty content; falling back to its thinking text")
            content = str(thinking).strip()
        return LLMResponse(
            content=content,
            prompt_tokens=int(getattr(response, "prompt_eval_count", 0) or 0),
            completion_tokens=int(getattr(response, "eval_count", 0) or 0),
            duration_ms=duration_ms,
            done_reason=getattr(response, "done_reason", None),
            thinking=thinking,
        )

    def _explain(self, exc: Exception) -> str:
        host = self.settings.ollama_host
        model = self.settings.model
        if isinstance(exc, ResponseError):
            text = str(exc)
            if "not found" in text.lower():
                return (
                    f"Ollama could not find model {model!r}. Run `ollama list` and "
                    f"`ollama pull {model}`, or pass --model with an installed model."
                )
            return f"Ollama returned an error: {text}"
        if isinstance(exc, (httpx.ConnectError, httpx.ConnectTimeout)):
            return (
                f"Could not connect to Ollama at {host}. Start it with `ollama serve` "
                "or set {{ env_prefix }}OLLAMA_HOST."
            )
        if isinstance(exc, httpx.ReadTimeout):
            return (
                f"Ollama timed out after {self.settings.request_timeout}s. "
                "Try a smaller model, a smaller context window, or a larger timeout."
            )
        return f"Ollama call failed: {type(exc).__name__}: {exc}"
