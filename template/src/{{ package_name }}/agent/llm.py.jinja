{% if llm_provider in ["openai", "both"] %}
{{ "\n\n" }}class OpenAICompatibleLLM:
    """Chat adapter for ``/v1/chat/completions`` endpoints."""

    def __init__(self, settings: Settings, *, tracer: Tracer | None = None) -> None:
        self.settings = settings
        self.tracer = tracer
        headers = {"Content-Type": "application/json"}
        if settings.openai_api_key:
            headers["Authorization"] = f"Bearer {settings.openai_api_key}"
        self.client = httpx.AsyncClient(
            base_url=settings.openai_base_url.rstrip("/") + "/",
            timeout=settings.request_timeout,
            headers=headers,
        )

    async def list_models(self) -> list[str]:
        try:
            response = await self.client.get("models")
            response.raise_for_status()
        except httpx.HTTPError as exc:
            raise LLMError(
                f"Could not list models at {self.settings.openai_base_url}: {exc}"
            ) from exc
        data = response.json()
        return [str(item["id"]) for item in data.get("data", []) if item.get("id")]

    async def chat(
        self,
        messages: list[dict[str, str]],
        *,
        stop: list[str] | None = None,
        temperature: float | None = None,
    ) -> LLMResponse:
        payload: dict[str, Any] = {
            "model": self.settings.model,
            "messages": messages,
            "stream": False,
            "temperature": self.settings.temperature if temperature is None else temperature,
        }
        if stop:
            payload["stop"] = stop
        if self.settings.max_tokens is not None:
            payload["max_tokens"] = self.settings.max_tokens

        started = time.perf_counter()
        try:
            response = await self.client.post("chat/completions", json=payload)
        except httpx.HTTPError as exc:
            raise LLMError(
                f"Could not reach {self.settings.openai_base_url}: {type(exc).__name__}: {exc}"
            ) from exc
        duration_ms = (time.perf_counter() - started) * 1000
        if response.status_code >= 400:
            detail = response.text[:500]
            raise LLMError(
                f"Provider returned HTTP {response.status_code}: {detail or '(no body)'}"
            )

        try:
            data = response.json()
            content = data["choices"][0]["message"].get("content") or ""
        except (ValueError, KeyError, IndexError, TypeError) as exc:
            raise LLMError(f"Unexpected provider response: {response.text[:500]}") from exc

        usage = data.get("usage") or {}
        result = LLMResponse(
            content=str(content).strip(),
            prompt_tokens=int(usage.get("prompt_tokens") or 0),
            completion_tokens=int(usage.get("completion_tokens") or 0),
            duration_ms=duration_ms,
            done_reason=data["choices"][0].get("finish_reason"),
        )

        if self.tracer is not None:
            with self.tracer.span(
                "llm.chat",
                kind="client",
                provider="openai",
                model=self.settings.model,
                message_count=len(messages),
                prompt_tokens=result.prompt_tokens,
                completion_tokens=result.completion_tokens,
                duration_ms=round(result.duration_ms, 3),
            ):
                pass
        log.debug(
            "llm response model=%s prompt_tokens=%s completion_tokens=%s duration_ms=%.0f",
            self.settings.model,
            result.prompt_tokens,
            result.completion_tokens,
            result.duration_ms,
        )
        return result

    async def aclose(self) -> None:
        await self.client.aclose()
{% endif %}


def build_llm(settings: Settings, *, tracer: Tracer | None = None) -> LLM:
    """Build the adapter selected by ``settings.provider``."""
    if settings.provider == "fake":
        return FakeLLM()
{% if llm_provider in ["ollama", "both"] %}
    if settings.provider == "ollama":
        return OllamaLLM(settings, tracer=tracer)
{% endif %}
{% if llm_provider in ["openai", "both"] %}
    if settings.provider == "openai":
        return OpenAICompatibleLLM(settings, tracer=tracer)
{% endif %}
    raise LLMError(f"Unsupported provider: {settings.provider!r}")
