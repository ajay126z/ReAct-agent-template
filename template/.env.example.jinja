# Copy to .env and adjust. Every setting can also be passed as a CLI flag.

# --- Model ---------------------------------------------------------------
{{ env_prefix }}PROVIDER={{ 'ollama' if llm_provider in ['ollama', 'both'] else 'openai' }}
{{ env_prefix }}MODEL={{ default_model }}
{{ env_prefix }}TEMPERATURE=0.1
{{ env_prefix }}MAX_TOKENS=
{{ env_prefix }}REQUEST_TIMEOUT=120

{% if llm_provider in ["ollama", "both"] %}
# --- Ollama --------------------------------------------------------------
{{ env_prefix }}OLLAMA_HOST=http://localhost:11434
{{ env_prefix }}NUM_CTX=8192
{{ env_prefix }}KEEP_ALIVE=10m
# Set true for thinking models; off keeps ReAct output parseable.
{{ env_prefix }}THINK=false
{% endif %}
{% if llm_provider in ["openai", "both"] %}
# --- OpenAI-compatible endpoint ------------------------------------------
{{ env_prefix }}OPENAI_BASE_URL=https://api.openai.com/v1
# {{ env_prefix }}OPENAI_API_KEY=sk-...
{% endif %}

# --- Agent ---------------------------------------------------------------
{{ env_prefix }}MAX_STEPS=8
{{ env_prefix }}MAX_PARSE_RETRIES=2
{{ env_prefix }}MAX_OBSERVATION_CHARS=2000
{% if include_sessions %}
{{ env_prefix }}MEMORY_TURNS=6
{{ env_prefix }}MEMORY_CHARS=4000
{% endif %}

# --- MCP transport -------------------------------------------------------
# stdio (local subprocess) or http (streamable HTTP server)
{{ env_prefix }}TRANSPORT=stdio
{{ env_prefix }}SERVER_URL=http://127.0.0.1:8000/mcp
# JSON list for an external stdio server, e.g. ["uvx", "my-mcp-server"]
# {{ env_prefix }}SERVER_COMMAND=

# --- Observability -------------------------------------------------------
{{ env_prefix }}TRACE_DIR=./traces
{{ env_prefix }}TRACE_ENABLED={{ 'true' if enable_tracing else 'false' }}
{{ env_prefix }}LOG_LEVEL=INFO
{% if include_sessions %}
{{ env_prefix }}SESSION_DIR=./data/sessions
{% endif %}
